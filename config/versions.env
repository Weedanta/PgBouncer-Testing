# Image tags (Tabel 3.9: "versi stabil terbaru pada saat pengujian, dikunci").
# `make pin` resolves every tag to its digest and writes config/images.lock.json;
# `make lock` copies that file into config/locked/. Bump a tag only BEFORE `make lock`.
# Tags checked against Docker Hub on 2026-10-06 (PostgreSQL 18.6 is the newest 18.x).
# cAdvisor: if this tag no longer pulls, take the newest release from
# https://github.com/google/cadvisor/releases and record it here.
POSTGRES_IMAGE=postgres:18.6-bookworm
# PgBouncer is installed from the PGDG apt repository that the official postgres image
# already configures. The Dockerfile installs the newest package whose version starts
# with this prefix and fails if there is none.
PGBOUNCER_VERSION_PREFIX=1.26.
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.8
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.1
PGBOUNCER_EXPORTER_IMAGE=prometheuscommunity/pgbouncer-exporter:v0.12.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
PROMETHEUS_IMAGE=prom/prometheus:v3.13.3
GRAFANA_IMAGE=grafana/grafana:12.4.12
PGNET_SUBNET=172.29.0.0/24
